# WeatherGPT Environment Configuration (SIH 2026)

# Server Environment
PORT=3000
NODE_ENV=development

# Demo Mode (true = use realistic simulated datasets, false = require live external APIs)
NEXT_PUBLIC_DEMO_MODE=true

# Meteorological & Forecast APIs (Optional for live mode)
IMD_API_KEY=your_imd_api_key_here
WEATHER_API_KEY=your_weatherapi_key_here
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# AI Services (Optional for dynamic live LLM reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# GIS Map Tiles
NEXT_PUBLIC_MAP_API_KEY=your_carto_or_mapbox_key

# Database & Caching
DATABASE_URL=postgresql://weathergpt_user:secret@localhost:5432/weathergpt
REDIS_URL=redis://localhost:6379/0
